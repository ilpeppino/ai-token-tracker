#!/usr/bin/env bash
set -euo pipefail

BASE="/Volumes/DevSSD/projects/ai-token-tracker"
PY="$BASE/.venv/bin/python"
STREAMLIT="$BASE/.venv/bin/streamlit"
DUMP_SCRIPT="$BASE/read-open-usage-tabs.sh"

case "${1:-dashboard}" in
  sync)
    "$DUMP_SCRIPT" || true
    "$PY" "$BASE/sync-usage.py"
    "$PY" "$BASE/sync-usage-percentages.py" || true
    "$PY" "$BASE/build-calibration-view.py" || true
    "$PY" "$BASE/build-quota-forecast-view.py" || true
    ;;

  sync-notify)
    "$DUMP_SCRIPT" || true
    "$PY" "$BASE/sync-usage.py"
    "$PY" "$BASE/sync-usage-percentages.py" || true
    "$PY" "$BASE/build-calibration-view.py" || true
    "$PY" "$BASE/build-quota-forecast-view.py" || true
    "$PY" "$BASE/notify.py"
    "$PY" "$BASE/reset-notify.py"
    ;;

  dashboard)
    "$DUMP_SCRIPT" || true
    "$PY" "$BASE/sync-usage.py"
    "$PY" "$BASE/sync-usage-percentages.py" || true
    "$PY" "$BASE/build-calibration-view.py" || true
    "$PY" "$BASE/build-quota-forecast-view.py" || true
    "$STREAMLIT" run "$BASE/dashboard.py" --server.headless=false
    ;;

  notify)
    "$PY" "$BASE/notify.py"
    ;;

  reset-notify)
    "$PY" "$BASE/reset-notify.py"
    ;;

  bot)
    "$PY" "$BASE/telegram-bot.py"
    ;;

  export)
    "$DUMP_SCRIPT" || true
    "$PY" "$BASE/sync-usage.py"
    "$PY" "$BASE/sync-usage-percentages.py" || true
    "$PY" "$BASE/build-calibration-view.py" || true
    "$PY" "$BASE/build-quota-forecast-view.py" || true
    "$PY" "$BASE/export-usage.py"
    ;;

  stats)
    "$BASE/token-stats.sh" "${2:-today}"
    ;;

  *)
    echo "Usage:"
    echo "  ai-tokens dashboard"
    echo "  ai-tokens sync"
    echo "    (dumps browser tabs, syncs usage, percentages, calibration view)"
    echo "  ai-tokens notify"
    echo "  ai-tokens reset-notify"
    echo "  ai-tokens bot"
    echo "  ai-tokens sync-notify"
    echo "  ai-tokens export"
    echo "  ai-tokens stats today"
    echo "  ai-tokens stats daily"
    exit 1
    ;;
esac
